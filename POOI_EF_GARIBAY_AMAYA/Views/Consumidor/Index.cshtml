@model IEnumerable<POOI_EF_GARIBAY_AMAYA.Models.Consumidor>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

@if (TempData["Mensaje"] != null)
{
    <div>
        @TempData["Mensaje"]
    </div>
}

<p>
    @Html.ActionLink("Create New", "Create")
</p>

@if (Model == null || !Model.Any())
{
    <label>No hay registros</label>
}
else
{

    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.dnicont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nomcont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.apecont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.emailcont)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idpais)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.dnicont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.nomcont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.apecont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.emailcont)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.idpais)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Update", new { dni = item.dnicont }) |
                    @Html.ActionLink("Details", "Details", new { dni = item.dnicont })|
                    @Html.ActionLink("Eliminar", "Delete", new { dni = item.dnicont })
                </td>
            </tr>
        }

    </table>
}